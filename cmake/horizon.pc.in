prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: horizon
Description: Horizon Desktop Core Library
Version: @HORIZON_VERSION@
Requires: wayland-client wayland-cursor wayland-egl cairo xkbcommon librsvg-2.0 egl glesv2 dbus-1 uuid fontconfig mount gio-2.0 gio-unix-2.0 libpipewire-0.3
Libs: -L${libdir} -lhorizon
Cflags: -I${includedir}/horizon -I${includedir}
