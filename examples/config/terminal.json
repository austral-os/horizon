                "white": "#ffffff",
                "yellow": "#ffffa5"
            },
            "normal": {
                "black": "#21222c",
                "blue": "#bd93f9",
                "cyan": "#8be9fd",
                "green": "#50fa7b",
                "magenta": "#ff79c6",
                "red": "#ff5555",
                "white": "#f8f8f2",
                "yellow": "#f1fa8c"
            },
            "primary": {
                "background": "#282a36",
