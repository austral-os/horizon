#!/bin/bash
export XDG_SESSION_TYPE=wayland
export XDG_CURRENT_DESKTOP=horizon:HZN-LABWC

# Forzar a GTK, Qt y Electron a usar los portales XDG para los diálogos
export GTK_USE_PORTAL=1
export QT_QPA_PLATFORMTHEME=xdgdesktopportal

# Limpiar sockets y locks huérfanos antes de iniciar el compositor para asegurar que use wayland-0
rm -f "$XDG_RUNTIME_DIR/wayland-[0-9]"
rm -f "$XDG_RUNTIME_DIR/wayland-[0-9].lock"

labwc &
export LABWC_PID=$!

# Esperar a que el socket del compositor esté disponible y exportar WAYLAND_DISPLAY
for i in {1..50}; do
    for socket in "$XDG_RUNTIME_DIR"/wayland-[0-9]; do
        if [ -S "$socket" ]; then
            export WAYLAND_DISPLAY=$(basename "$socket")
            break 2
        fi
    done
    sleep 0.1
done

# Esperar a que el socket de XWayland esté disponible y exportar DISPLAY
for i in {1..50}; do
    DISPLAY_NUM=$(pgrep -af Xwayland | sed -n 's/.*Xwayland \(:[0-9]\+\).*/\1/p' | head -n1)

    if [ -n "$DISPLAY_NUM" ]; then
        export DISPLAY="$DISPLAY_NUM"
        break
    fi

    sleep 0.1
done

# Import environment for user services and start audio daemons (with timeout to prevent hanging)
timeout 2 systemctl --user import-environment WAYLAND_DISPLAY XDG_CURRENT_DESKTOP DISPLAY XDG_SESSION_TYPE || true
timeout 2 dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP DISPLAY XDG_SESSION_TYPE || true
timeout 2 systemctl --user start pipewire pipewire-pulse wireplumber || true

@CMAKE_INSTALL_FULL_BINDIR@/horizon_session --compositor labwc

# Terminate the compositor gracefully and wait for it to release resources
kill -TERM $LABWC_PID 2>/dev/null || true
wait $LABWC_PID 2>/dev/null || true
